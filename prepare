#!/usr/bin/env bash
# Makes the codec placeholders of both trees: the releases' own scripts, prepare_GD77 (firmware/, MK22) and
# prepare_MDUV380 (MDUV380_firmware/, STM32), kept unchanged
status=0
[ -d firmware ] && { bash ./prepare_GD77 || status=1; }
[ -d MDUV380_firmware ] && { bash ./prepare_MDUV380 || status=1; }
exit $status
